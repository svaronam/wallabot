# Configuración de Wallabot. El instalador la copia a server/.env
WALLABOT_PORT=8788
WALLABOT_DB=data/wallabot.db
# Token para la APK y el panel (el instalador genera uno si lo dejas vacío)
WALLABOT_TOKEN=
# Punto central de las búsquedas (cada búsqueda puede tener el suyo)
WALLABOT_LAT=40.4168
WALLABOT_LNG=-3.7038
# Segundos mínimos entre peticiones a Wallapop (más alto = más prudente)
WALLABOT_REQUEST_GAP=3
# Horas entre revisiones de cada anuncio (vendido, reservado, precio)
WALLABOT_RECHECK_ALERT_H=3
WALLABOT_RECHECK_MARKET_H=8
WALLABOT_RECHECK_BUDGET=6
# Hora del resumen diario
WALLABOT_DAILY_HOUR=21
WALLABOT_KEEP_DAYS=180
TZ=Europe/Madrid
