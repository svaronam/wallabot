<?xml version="1.0" encoding="utf-8"?>
<!-- El bot va por http dentro de Tailscale, que ya cifra todo el tráfico. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
